# Local Vite development server port (copy to .env for development).
DEV_PORT=5173
# Export these when running Playwright; its Node config reads process.env.
PLAYWRIGHT_PORT=4173
# Optional existing preview URL; defaults to the loopback URL at PLAYWRIGHT_PORT.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
# Permit an already-running production preview only when explicitly requested.
PLAYWRIGHT_REUSE_SERVER=false
